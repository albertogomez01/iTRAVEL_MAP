# --------------------------------------------------------
# iTRAVEL_MAP - Configuración de Variables de Entorno
# --------------------------------------------------------

# 1. API Key de Google Gemini (Obtén la tuya en https://aistudio.google.com/)
VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# 2. Configuración de Firebase (Google Sign-In)
# Crea un proyecto gratis en https://console.firebase.google.com/
# Habilita Authentication -> Google Provider
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
